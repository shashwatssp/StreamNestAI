# Production Environment Configuration

# Application Settings
GIN_MODE=release
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info

# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here
MONGO_DATABASE=streamnest_production
MONGODB_URI=mongodb://admin:your_secure_mongo_password_here@mongodb:27017/streamnest_production?authSource=admin

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Security
CSRF_SECRET=your_csrf_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Analytics
ANALYTICS_ENABLED=true
EVENT_BATCH_SIZE=100
EVENT_FLUSH_INTERVAL=30s

# WebSocket
WS_ENABLED=true
WS_PING_INTERVAL=30s
WS_PONG_WAIT=10s

# Recommendations
RECOMMENDATION_ENABLED=true
ML_MODEL_UPDATE_INTERVAL=1h
COLLABORATIVE_FILTERING_MIN_USERS=10

# Social Features
SOCIAL_ENABLED=true
ACTIVITY_FEED_LIMIT=50
MAX_FOLLOWERS=1000

# File Upload
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@streamnest.com

# External APIs
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.streamnest.com
CDN_ACCESS_KEY=your_cdn_access_key
CDN_SECRET_KEY=your_cdn_secret_key

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=streamnest

# Logging
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=30

# Performance
MAX_CONNECTIONS=1000
MAX_IDLE_CONNECTIONS=100
CONNECTION_MAX_LIFETIME=1h
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# Cache Configuration
CACHE_TTL=1h
CACHE_CLEANUP_INTERVAL=30m
MAX_CACHE_SIZE=1000

# Background Jobs
WORKER_POOL_SIZE=10
JOB_QUEUE_SIZE=1000
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5s

# Health Checks
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here

# Development/Debug (disable in production)
DEBUG=false
PROFILING_ENABLED=false
PPROF_ENABLED=false