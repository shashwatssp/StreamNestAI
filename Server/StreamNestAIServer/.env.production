# StreamNestAI Enhanced - Production Environment
# This file is configured for production deployment

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/StreamNest
DATABASE_NAME=StreamNest

# Redis Configuration (Production - Redis Cloud)
REDIS_ADDR=redis-13554.crce182.ap-south-1-1.ec2.cloud.redislabs.com:13554
REDIS_HOST=redis-13554.crce182.ap-south-1-1.ec2.cloud.redislabs.com
REDIS_PORT=13554
REDIS_PASSWORD=HWg60QKmrYFlWmrf3pr0Utv8IC5eU8QG
REDIS_DB=0
REDIS_POOL_SIZE=100

# JWT Configuration (Production - Use strong secrets)
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_SECRET
JWT_EXPIRES_IN=24h

# Server Configuration
GIN_MODE=release
PORT=8080
HOST=0.0.0.0

# CORS Configuration (Production - Update with your domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST_SIZE=200
RATE_LIMIT_WINDOW_DURATION=60s

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_PATH=/metrics

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# WebSocket Configuration
WS_PING_PERIOD=54s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s
WS_MAX_MESSAGE_SIZE=512

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=30s

# Recommendation Configuration
RECOMMENDATION_ENABLED=true
RECOMMENDATION_CACHE_TTL=1800s
RECOMMENDATION_MAX_RESULTS=20

# Social Features Configuration
SOCIAL_ENABLED=true
SOCIAL_FEED_LIMIT=50
SOCIAL_MAX_FOLLOWERS=1000

# Security Configuration
SECURITY_ENABLED=true
SECURITY_AUDIT_ENABLED=true
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=15m

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov

# External Services (Production - Use real API keys)
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY
BASE_PROMPT_TEMPLATE=Analyze the sentiment of this movie review and respond with exactly one of these ratings: {rankings}. Review:

# Cloud Storage (Production - Configure AWS)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=streamnestai-production-uploads

# Production Specific
ENVIRONMENT=production
DEBUG=false
ENABLE_CORS_LOGGING=false

# Redis Cloud Connection String (for debugging)
REDIS_CONNECTION_STRING=redis://default:HWg60QKmrYFlWmrf3pr0Utv8IC5eU8QG@redis-13554.crce182.ap-south-1-1.ec2.cloud.redislabs.com:13554