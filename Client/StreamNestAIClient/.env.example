# StreamNestAI Client - Environment Configuration
# Copy this to .env and fill in your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_API_VERSION=v1

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8080
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# Application Configuration
VITE_APP_NAME=StreamNestAI
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Enhanced Streaming Platform

# Feature Flags
VITE_ENABLE_SOCIAL_FEATURES=true
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true
VITE_ENABLE_WATCH_PARTIES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_RECOMMENDATIONS=true

# UI Configuration
VITE_THEME=dark
VITE_DEFAULT_LANGUAGE=en
VITE_ITEMS_PER_PAGE=20
VITE_MAX_UPLOAD_SIZE=10485760

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_ENABLE_OFFLINE_MODE=true

# Analytics Configuration
VITE_ENABLE_GOOGLE_ANALYTICS=false
VITE_GA_TRACKING_ID=your-ga-tracking-id

# Development Configuration
VITE_DEV_MODE=true
VITE_ENABLE_DEBUG_LOGS=true
VITE_MOCK_API=false

# Production Overrides (Uncomment for production)
# VITE_API_BASE_URL=https://your-render-app.onrender.com
# VITE_WS_URL=wss://your-render-app.onrender.com
# VITE_DEV_MODE=false
# VITE_ENABLE_DEBUG_LOGS=false
